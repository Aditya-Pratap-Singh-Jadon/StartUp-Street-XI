MONGODB_URI=mongodb://localhost:27017/ssxi2
MONGODB_DB_NAME=SSXI
JWT_SECRET=your_super_secret_jwt_key
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Email Settings (for OTP)
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
SMTP_SECURE=false

# Google Drive (for Submission PPTs)
# Use OAuth2 with your personal Google account (NOT service account)
# Run: node scripts/get-drive-token.js  to generate the refresh token
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
GOOGLE_DRIVE_REFRESH_TOKEN=your_refresh_token_from_get-drive-token-script
GOOGLE_DRIVE_FOLDER_ID=your_drive_folder_id_only_no_url

# Legacy service account vars — no longer used for uploads, safe to remove
# GOOGLE_SERVICE_ACCOUNT_EMAIL=
# GOOGLE_PRIVATE_KEY=
