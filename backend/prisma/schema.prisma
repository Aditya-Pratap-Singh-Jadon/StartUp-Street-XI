generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Profile {
  id               String   @id @map("_id") @default(uuid())
  email            String   @unique
  password         String?
  provider         String   @default("local")
  name             String?
  phone            String?
  reg_no           String?
  block            String?
  room             String?
  role             String   @default("participant")
  participant_type String   @default("vit_student")
  created_at       DateTime @default(now())
  @@index([role])
}

model OTP {
  id        String   @id @map("_id") @default(uuid())
  email     String
  otp       String
  createdAt DateTime @default(now())
  @@index([email, otp])
  @@index([createdAt])
}

model Announcement {
  id         String    @id @map("_id") @default(uuid())
  title      String
  content    String
  priority   String    @default("normal")
  published  Boolean   @default(true)
  expires_at DateTime?
  created_at DateTime  @default(now())
  @@index([published, created_at])
}

model EventConfig {
  id    String @id @map("_id") @default(uuid())
  key   String @unique
  value String
}

model FAQ {
  id         String   @id @map("_id") @default(uuid())
  question   String
  answer     String
  category   String   @default("General")
  sort_order Int      @default(0)
  published  Boolean  @default(true)
  created_at DateTime @default(now())
  @@index([published, sort_order])
}

model Judge {
  id           String   @id @map("_id") @default(uuid())
  name         String
  designation  String?
  organization String?
  description  String?
  photo_url    String?
  sort_order   Int      @default(0)
  published    Boolean  @default(true)
  created_at   DateTime @default(now())
  @@index([published, sort_order])
}

model Notification {
  id         String   @id @map("_id") @default(uuid())
  user_id    String
  title      String
  body       String
  type       String?
  read       Boolean  @default(false)
  created_at DateTime @default(now())
  @@index([user_id, created_at])
}

model Result {
  id         String   @id @map("_id") @default(uuid())
  team_name  String
  team_code  String?
  position   String?
  category   String?
  description String?
  sort_order Int      @default(0)
  published  Boolean  @default(false)
  created_at DateTime @default(now())
  @@index([published, sort_order])
}

model Team {
  id         String   @id @map("_id") @default(uuid())
  name       String
  code       String   @unique
  leader_id  String
  is_selected_for_jury Boolean @default(false)
  created_at DateTime @default(now())
  @@index([leader_id])
}

model TeamMember {
  id        String   @id @map("_id") @default(uuid())
  team_id   String
  user_id   String
  joined_at DateTime @default(now())
  @@unique([team_id, user_id])
  @@unique([user_id])
  @@index([team_id, joined_at])
}

model Submission {
  id                String   @id @map("_id") @default(uuid())
  team_id           String
  round             Int      @default(1)
  file_name         String?
  file_url          String?
  file_type         String?
  file_size         Int?
  file_data         Bytes?
  file_content_type String?
  github_url        String?
  status            String   @default("submitted")
  submitted_by      String?
  updated_at        DateTime?
  created_at        DateTime @default(now())
  @@index([created_at])
  @@unique([team_id, round])
}

model TimelineEvent {
  id           String   @id @map("_id") @default(uuid())
  title        String
  description  String?
  event_time   DateTime?
  sort_order   Int      @default(0)
  published    Boolean  @default(true)
  is_current   Boolean  @default(false)
  is_completed Boolean  @default(false)
  created_at   DateTime @default(now())
  @@index([published, sort_order])
}
